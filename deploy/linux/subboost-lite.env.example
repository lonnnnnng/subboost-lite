SUBCONVERT_HOST=192.168.1.2
PORT=9999
SUBCONVERT_ALLOWED_ORIGINS=http://192.168.1.2:9999
SUBCONVERT_MIHOMO_DIR=/var/cache/subboost-lite/mihomo
# long: systemd 已设置此固定路径，升级后继续使用同一隐藏密码文件；首次启动由服务账号自动生成。
SUBCONVERT_PASSWORD_FILE=/var/lib/subboost-lite/.access-password
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
